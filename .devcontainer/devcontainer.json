{
  "name": "vcex",
  "image": "mcr.microsoft.com/devcontainers/elixir:1.19",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/rust:1": {}
  },
  "postCreateCommand": "npm install",
  "forwardPorts": [4000],
  "customizations": {
    "vscode": {
      "extensions": [
        "elixir-lsp.elixir-ls",
        "rust-lang.rust-analyzer"
      ]
    }
  }
}

